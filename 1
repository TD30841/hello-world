def selection_sort(arr):
    n=len(arr)
    for i in range(n):
        min_idx=i
        for j in range(i+1,n):
            if arr[j]<arr[min_idx]:
                min_idx =j
        arr[i],arr[min_idx]=arr[min_idx],arr[i]
    return arr        
        
lst = [5, 2, 1, 6, 3, 4]
print(lst)
sorted_lst = selection_sort(lst)
print(sorted_lst)
print(lst) 

